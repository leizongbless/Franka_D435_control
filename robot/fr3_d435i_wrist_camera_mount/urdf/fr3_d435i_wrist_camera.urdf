<?xml version="1.0"?>
<robot name="fr3_d435i_wrist_camera">
  <!-- Standalone approximation of FR3 kinematics with the supplied wrist mount.
       Replace the primitive arm visuals with official franka_description meshes when available. -->
  <material name="franka_white"><color rgba="0.85 0.85 0.82 1"/></material>
  <material name="franka_dark"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="mount_gray"><color rgba="0.25 0.28 0.30 1"/></material>
  <material name="camera_black"><color rgba="0.03 0.03 0.03 1"/></material>
  <material name="camera_glass"><color rgba="0.05 0.20 0.30 1"/></material>

  <link name="world"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.10"/><geometry><cylinder radius="0.17" length="0.20"/></geometry><material name="franka_white"/></visual>
    <collision><origin xyz="0 0 0.10"/><geometry><cylinder radius="0.17" length="0.20"/></geometry></collision>
    <inertial><origin xyz="0 0 0.10"/><mass value="10"/><inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.12"/></inertial>
  </link>
  <joint name="world_to_base" type="fixed"><parent link="world"/><child link="base_link"/><origin xyz="0 0 0"/></joint>

  <link name="panda_link1"><visual><origin xyz="0 0 0.20"/><geometry><cylinder radius="0.07" length="0.40"/></geometry><material name="franka_white"/></visual><collision><origin xyz="0 0 0.20"/><geometry><cylinder radius="0.07" length="0.40"/></geometry></collision><inertial><origin xyz="0 0 0.20"/><mass value="3.0"/><inertia ixx="0.11" ixy="0" ixz="0" iyy="0.11" iyz="0" izz="0.02"/></inertial></link>
  <joint name="panda_joint1" type="revolute"><parent link="base_link"/><child link="panda_link1"/><origin xyz="0 0 0.20" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-2.8973" upper="2.8973" effort="87" velocity="2.175"/></joint>

  <link name="panda_link2"><visual><origin xyz="0 0 -0.20"/><geometry><box size="0.14 0.14 0.40"/></geometry><material name="franka_white"/></visual><collision><origin xyz="0 0 -0.20"/><geometry><box size="0.14 0.14 0.40"/></geometry></collision><inertial><origin xyz="0 0 -0.20"/><mass value="2.5"/><inertia ixx="0.09" ixy="0" ixz="0" iyy="0.09" iyz="0" izz="0.02"/></inertial></link>
  <joint name="panda_joint2" type="revolute"><parent link="panda_link1"/><child link="panda_link2"/><origin xyz="0 0 0.40" rpy="-1.57079632679 0 0"/><axis xyz="0 0 1"/><limit lower="-1.7628" upper="1.7628" effort="87" velocity="2.175"/></joint>

  <link name="panda_link3"><visual><origin xyz="0.20 0 0" rpy="0 1.57079632679 0"/><geometry><cylinder radius="0.055" length="0.40"/></geometry><material name="franka_white"/></visual><collision><origin xyz="0.20 0 0" rpy="0 1.57079632679 0"/><geometry><cylinder radius="0.055" length="0.40"/></geometry></collision><inertial><origin xyz="0.20 0 0"/><mass value="2.7"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.10" iyz="0" izz="0.10"/></inertial></link>
  <joint name="panda_joint3" type="revolute"><parent link="panda_link2"/><child link="panda_link3"/><origin xyz="0 0 -0.40" rpy="1.57079632679 0 0"/><axis xyz="0 0 1"/><limit lower="-2.8973" upper="2.8973" effort="87" velocity="2.175"/></joint>

  <link name="panda_link4"><visual><origin xyz="0 0 0.20"/><geometry><box size="0.12 0.12 0.40"/></geometry><material name="franka_white"/></visual><collision><origin xyz="0 0 0.20"/><geometry><box size="0.12 0.12 0.40"/></geometry></collision><inertial><origin xyz="0 0 0.20"/><mass value="2.4"/><inertia ixx="0.09" ixy="0" ixz="0" iyy="0.09" iyz="0" izz="0.02"/></inertial></link>
  <joint name="panda_joint4" type="revolute"><parent link="panda_link3"/><child link="panda_link4"/><origin xyz="0.40 0 0" rpy="1.57079632679 0 0"/><axis xyz="0 0 1"/><limit lower="-3.0718" upper="-0.0698" effort="87" velocity="2.175"/></joint>

  <link name="panda_link5"><visual><origin xyz="0.20 0 0" rpy="0 1.57079632679 0"/><geometry><cylinder radius="0.05" length="0.40"/></geometry><material name="franka_white"/></visual><collision><origin xyz="0.20 0 0" rpy="0 1.57079632679 0"/><geometry><cylinder radius="0.05" length="0.40"/></geometry></collision><inertial><origin xyz="0.20 0 0"/><mass value="2.2"/><inertia ixx="0.025" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/></inertial></link>
  <joint name="panda_joint5" type="revolute"><parent link="panda_link4"/><child link="panda_link5"/><origin xyz="0 0 0.40" rpy="-1.57079632679 0 0"/><axis xyz="0 0 1"/><limit lower="-2.8973" upper="2.8973" effort="12" velocity="2.61"/></joint>

  <link name="panda_link6"><visual><origin xyz="0 0 0.13"/><geometry><box size="0.10 0.10 0.26"/></geometry><material name="franka_white"/></visual><collision><origin xyz="0 0 0.13"/><geometry><box size="0.10 0.10 0.26"/></geometry></collision><inertial><origin xyz="0 0 0.13"/><mass value="1.8"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.01"/></inertial></link>
  <joint name="panda_joint6" type="revolute"><parent link="panda_link5"/><child link="panda_link6"/><origin xyz="0.40 0 0" rpy="1.57079632679 0 0"/><axis xyz="0 0 1"/><limit lower="-0.0175" upper="3.7525" effort="12" velocity="2.61"/></joint>

  <link name="panda_link7"><visual><origin xyz="0 0 0.10"/><geometry><cylinder radius="0.06" length="0.20"/></geometry><material name="franka_white"/></visual><collision><origin xyz="0 0 0.10"/><geometry><cylinder radius="0.06" length="0.20"/></geometry></collision><inertial><origin xyz="0 0 0.10"/><mass value="1.2"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
  <joint name="panda_joint7" type="revolute"><parent link="panda_link6"/><child link="panda_link7"/><origin xyz="0 0 0.26" rpy="-1.57079632679 0 0"/><axis xyz="0 0 1"/><limit lower="-2.8973" upper="2.8973" effort="12" velocity="2.61"/></joint>
  <link name="panda_hand"><visual><origin xyz="0 0 0.10"/><geometry><box size="0.11 0.11 0.20"/></geometry><material name="franka_dark"/></visual><collision><origin xyz="0 0 0.10"/><geometry><box size="0.11 0.11 0.20"/></geometry></collision><inertial><origin xyz="0 0 0.10"/><mass value="0.73"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial></link>
  <joint name="panda_hand_joint" type="fixed"><parent link="panda_link7"/><child link="panda_hand"/><origin xyz="0 0 0.20"/></joint>
  <link name="panda_gripper"><visual><origin xyz="0 0 0.08"/><geometry><box size="0.08 0.08 0.16"/></geometry><material name="franka_dark"/></visual><collision><origin xyz="0 0 0.08"/><geometry><box size="0.08 0.08 0.16"/></geometry></collision><inertial><origin xyz="0 0 0.08"/><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="panda_gripper_joint" type="fixed"><parent link="panda_hand"/><child link="panda_gripper"/><origin xyz="0 0 0.20"/></joint>

  <!-- Supplied mount STL is in millimetres; the 0.001 scale converts it to metres. -->
  <link name="fr3_d435i_mount"><visual><origin xyz="-0.055 -0.050 -0.011"/><geometry><mesh filename="../models/FR3_D435i_mount.stl" scale="0.001 0.001 0.001"/></geometry><material name="mount_gray"/></visual><collision><origin xyz="-0.055 -0.050 -0.011"/><geometry><mesh filename="../models/FR3_D435i_mount.stl" scale="0.001 0.001 0.001"/></geometry></collision><inertial><mass value="0.20"/><inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/></inertial></link>
  <joint name="fr3_mount_joint" type="fixed"><parent link="panda_gripper"/><child link="fr3_d435i_mount"/><origin xyz="0 0 0.02" rpy="0 0 0"/></joint>

  <!-- D435i envelope: 90 x 25 x 25 mm. Camera optical axis points +X. -->
  <link name="d435i_link"><visual><origin xyz="0 0 0"/><geometry><box size="0.090 0.025 0.025"/></geometry><material name="camera_black"/></visual><collision><origin xyz="0 0 0"/><geometry><box size="0.090 0.025 0.025"/></geometry></collision><visual><origin xyz="0.038 -0.013 0" rpy="0 1.57079632679 0"/><geometry><cylinder radius="0.004" length="0.001"/></geometry><material name="camera_glass"/></visual><inertial><mass value="0.09"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00007" iyz="0" izz="0.00007"/></inertial></link>
  <joint name="d435i_mount_joint" type="fixed"><parent link="fr3_d435i_mount"/><child link="d435i_link"/><origin xyz="0.055 0 0.055" rpy="0 0 0"/></joint>
  <link name="d435i_color_frame"/><joint name="d435i_color_joint" type="fixed"><parent link="d435i_link"/><child link="d435i_color_frame"/><origin xyz="0.045 0 0" rpy="0 0 0"/></joint>
  <link name="d435i_color_optical_frame"/><joint name="d435i_color_optical_joint" type="fixed"><parent link="d435i_color_frame"/><child link="d435i_color_optical_frame"/><origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/></joint>
  <link name="d435i_depth_frame"/><joint name="d435i_depth_joint" type="fixed"><parent link="d435i_link"/><child link="d435i_depth_frame"/><origin xyz="0.045 0.006 0"/></joint>
  <link name="d435i_depth_optical_frame"/><joint name="d435i_depth_optical_joint" type="fixed"><parent link="d435i_depth_frame"/><child link="d435i_depth_optical_frame"/><origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/></joint>
  <link name="d435i_imu_frame"/><joint name="d435i_imu_joint" type="fixed"><parent link="d435i_link"/><child link="d435i_imu_frame"/><origin xyz="-0.015 0 0"/></joint>
</robot>
