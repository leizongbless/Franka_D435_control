<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3_d435i_wrist_camera_attachment">
  <xacro:macro name="fr3_d435i_wrist_camera" params="parent_link mount_xyz:='0 0 0.02' mount_rpy:='0 0 0' mesh_filename:='../models/FR3_D435i_mount.stl'">
    <link name="fr3_d435i_mount">
      <visual><origin xyz="-0.055 -0.050 -0.011"/><geometry><mesh filename="${mesh_filename}" scale="0.001 0.001 0.001"/></geometry><material name="mount_gray"><color rgba="0.25 0.28 0.30 1"/></material></visual>
      <collision><origin xyz="-0.055 -0.050 -0.011"/><geometry><mesh filename="${mesh_filename}" scale="0.001 0.001 0.001"/></geometry></collision>
      <inertial><mass value="0.20"/><inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/></inertial>
    </link>
    <joint name="fr3_mount_joint" type="fixed"><parent link="${parent_link}"/><child link="fr3_d435i_mount"/><origin xyz="${mount_xyz}" rpy="${mount_rpy}"/></joint>
    <link name="d435i_link">
      <visual><geometry><box size="0.090 0.025 0.025"/></geometry><material name="camera_black"><color rgba="0.03 0.03 0.03 1"/></material></visual>
      <collision><geometry><box size="0.090 0.025 0.025"/></geometry></collision>
      <inertial><mass value="0.09"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00007" iyz="0" izz="0.00007"/></inertial>
    </link>
    <joint name="d435i_mount_joint" type="fixed"><parent link="fr3_d435i_mount"/><child link="d435i_link"/><origin xyz="0.055 0 0.055"/></joint>
    <link name="d435i_color_frame"/><joint name="d435i_color_joint" type="fixed"><parent link="d435i_link"/><child link="d435i_color_frame"/><origin xyz="0.045 0 0"/></joint>
    <link name="d435i_color_optical_frame"/><joint name="d435i_color_optical_joint" type="fixed"><parent link="d435i_color_frame"/><child link="d435i_color_optical_frame"/><origin rpy="-1.57079632679 0 -1.57079632679"/></joint>
    <link name="d435i_depth_frame"/><joint name="d435i_depth_joint" type="fixed"><parent link="d435i_link"/><child link="d435i_depth_frame"/><origin xyz="0.045 0.006 0"/></joint>
    <link name="d435i_depth_optical_frame"/><joint name="d435i_depth_optical_joint" type="fixed"><parent link="d435i_depth_frame"/><child link="d435i_depth_optical_frame"/><origin rpy="-1.57079632679 0 -1.57079632679"/></joint>
    <link name="d435i_imu_frame"/><joint name="d435i_imu_joint" type="fixed"><parent link="d435i_link"/><child link="d435i_imu_frame"/><origin xyz="-0.015 0 0"/></joint>
  </xacro:macro>
</robot>
